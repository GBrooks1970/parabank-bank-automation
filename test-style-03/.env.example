# Test style 03 settings (identical to test style 02). Export these in your shell (no dotenv dependency).
# Default target: the local pinned Docker SUT.
PARABANK_URL=http://localhost:8090
PARABANK_USERNAME=john
PARABANK_PASSWORD=demo
# Live demo, only when directed: PARABANK_URL=https://parabank.parasoft.com
# (never reset; the overdraft test is skipped there; see README "Run against the live demo").
# 1 skips the reset of the LOCAL SUT. A remote host is never reset anyway (DR-PB-13).
PARABANK_SKIP_RESET=0
