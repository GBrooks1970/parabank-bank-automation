{
  "name": "parabank-bank-automation",
  "version": "0.3.0",
  "private": true,
  "description": "Test automation against the ParaBank demo bank: API-first screenplay BDD lane and a Serenity/JS + Playwright + Cucumber UI journey lane.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:style-02": "tsc -p test-style-02/tsconfig.json",
    "typecheck:style-03": "tsc -p test-style-03/tsconfig.json",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "lint:tags": "tsx scripts/check-tags.ts",
    "test:api": "cucumber-js --profile api",
    "pretest:ui": "node -e \"require('node:fs').rmSync('target/site/serenity',{recursive:true,force:true})\"",
    "test:ui": "cucumber-js --profile ui",
    "test:style-02": "playwright test -c test-style-02/playwright.config.ts",
    "pretest:style-03": "node -e \"require('node:fs').rmSync('test-style-03/target/site/serenity',{recursive:true,force:true})\"",
    "test:style-03": "playwright test -c test-style-03/playwright.config.ts",
    "report:style-03": "node scripts/report-style-03.mjs",
    "check:style-03-report": "tsx scripts/check-style-03-report.ts",
    "report": "node scripts/report.mjs",
    "check:smoke-safety": "tsx scripts/smoke-safety.mjs",
    "check:report": "tsx scripts/check-report.ts",
    "prepare:pages": "tsx scripts/prepare-pages-report.ts",
    "check:pages": "tsx scripts/check-pages-report.ts",
    "perf:typecheck": "tsc -p perf/tsconfig.json",
    "perf:build": "npm run perf:typecheck && node perf/build.mjs",
    "perf:run": "tsx scripts/run-perf.mjs",
    "perf": "npm run perf:build && npm run perf:run",
    "verify": "npm run typecheck && npm run test:unit && npm run lint:tags && npm run check:smoke-safety && npm run test:api && npm run test:ui && npm run report && npm run check:report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@playwright/test": "~1.61.1",
    "@serenity-js/assertions": "^3.44.1",
    "@serenity-js/console-reporter": "^3.44.1",
    "@serenity-js/core": "^3.44.1",
    "@serenity-js/cucumber": "^3.44.1",
    "@serenity-js/playwright": "^3.44.1",
    "@serenity-js/playwright-test": "3.44.1",
    "@serenity-js/rest": "3.44.1",
    "@serenity-js/serenity-bdd": "^3.43.2",
    "@serenity-js/web": "^3.44.1",
    "@types/k6": "^2.0.1",
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "^0.28.1",
    "playwright": "~1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
