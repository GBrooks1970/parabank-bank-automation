# Test style 02 settings. Export these in your shell (no dotenv dependency).
# Default target: the local pinned Docker SUT.
PARABANK_URL=http://localhost:8090
PARABANK_USERNAME=john
PARABANK_PASSWORD=demo
# Set to 1 only for a shared environment that must not be reset (e.g. the public demo).
PARABANK_SKIP_RESET=0
